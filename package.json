{
  "name": "nuke-family-helper-script",
  "version": "2.21.0",
  "description": "Userscript making things easier for the Nuke Family faction on Torn.com",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "build:dev": "node build.mjs --debug",
    "watch": "node build.mjs --watch",
    "watch:debug": "node build.mjs --watch --debug",
    "watch:debug-site": "node build.mjs --watch --debug-site",
    "test": "node test/run.mjs",
    "fixtures:css": "node test/tools/fetch-torn-css.mjs",
    "fixtures:css:refresh": "node test/tools/fetch-torn-css.mjs --refresh",
    "fixtures": "node tools/fixture-recorder/cli.mjs",
    "recorder": "node tools/fixture-recorder/server.mjs",
    "recorder:xpi": "node tools/fixture-recorder/pack.mjs"
  },
  "author": "Fogest <nuke@jhvisser.com>",
  "license": "UNLICENSED",
  "devDependencies": {
    "esbuild": "^0.28.1",
    "playwright": "^1.64.0"
  },
  "engines": {
    "node": ">=20"
  }
}
