.d .skill-tree.war-mode .switcher-timer,
.d .skill-tree .switcher-timer.invisible {
    opacity: 0;
}

.d .skill-tree-switcher {
    position: absolute;
    top: 25px;
    right: 30px;
    left: auto;
}

.d .skill-tree-switcher input[switch] {
    position: absolute;
    left: -99999px;
}

.d .skill-tree-switcher input[switch] + label {
    cursor: pointer;
    display: inline-block;
    vertical-align: middle;
    text-align: center;
    position: relative;
    width: 4px;
    height: 119px;
    text-transform: uppercase;
    text-indent: -99999px;
    border: 6px solid #111;
    box-shadow: 0 1px 0 #FFFFFF1A;
    border-radius: 16px;
    background: transparent linear-gradient(180deg, #3d5102 0%, #14150e 100%) 0 0 no-repeat;
    margin-left: 10px;
}

.d .skill-tree-switcher input[switch]:disabled + label {
    cursor: default;
}

.d .skill-tree-switcher input[switch] + label:before {
    content: attr(data-off-label);
    display: block;
    text-transform: uppercase;
    position: absolute;
    right: 39px;
    top: 8px;
    text-align: center;
    text-indent: 0;
    font: normal normal normal 30px/37px Fjalla One;
    color: #85B200;
    text-shadow: 0 0 25px #85B200BF;
}

.d .skill-tree-switcher input[switch] + label:after {
    content: '';
    position: absolute;
    left: -4px;
    top: -4px;
    width: 12px;
    height: 12px;
    border-radius: 12px;
    background: transparent linear-gradient(180deg, #DAD5D2 1%, #B7B0B0 26%, #F2F2F2 52%, #ABA6A7 87%, #989696 99%) 0 0 no-repeat;
    box-shadow: 0 1px 2px #00000073;
}

.d .skill-tree-switcher input[switch]:checked + label {
    background: transparent linear-gradient(180deg, #1C1A1A 0%, #583226 100%) 0 no-repeat;
}

.d .skill-tree-switcher input[switch]:checked + label:before {
    width: 104px;
    height: 65px;
    left: -120px;
    right: auto;
    top: 74px;
    content: attr(data-on-label);
    font: normal normal normal 30px/37px Fjalla One;
    color: #FF5C26;
    text-shadow: 0 0 25px #FF5C26BF;
}

.d .skill-tree-switcher input[switch]:checked + label:after {
    bottom: -4px;
    top: auto;
}

.d .skill-tree-switcher .modes-wrap {
    float: left;
    width: 104px;
    height: 130px;
    text-transform: uppercase;
    text-align: center;
    font: normal normal normal 30px/37px Fjalla One;
    color: #111;
    text-shadow: 0 -1px 0 #FFFFFF12;
}

.d .skill-tree-switcher .modes-wrap .peace-wrap,
.d .skill-tree-switcher .modes-wrap .war-wrap {
    width: 104px;
    height: 65px;
    line-height: 66px;
    box-shadow: inset 0 0 10px #000000BF;
    background: #2B2B2B 0 0 no-repeat;
    border-radius: 5px 5px 0 0;
}

.d .skill-tree-switcher .modes-wrap .war-wrap {
    border-radius: 0 0 5px 5px;
    margin-top: 1px;
}

.d .skill-tree-switcher .switcher-timer {
    font: normal normal normal 12px/15px Fjalla One;
    color: #F4FCE3;
    width: 104px;
    height: 15px;
    text-align: center;
    padding-bottom: 10px;
    position: absolute;
    top: 142px;
}

.d .skill-tree-switcher input[switch]:disabled + label + .modes-wrap .peace-wrap,
.d .skill-tree-switcher input[switch]:disabled + label + .modes-wrap .war-wrap {
    background-color: rgba(43, 43, 43, 0.5);
    color: rgba(17, 17, 17, 0.6);
}

.d .skill-tree-switcher input[switch]:disabled + label:after {
    background: linear-gradient(to bottom,  #7e7977 0%, #797373 13%, #939190 50%, #939190 56%, #767171 100%);
}

.d .skill-tree-switcher div.switcher-confirm {
    display: none;
    position: absolute;
    text-align: center;
    left: 0;
    right: 0;
    top: 141px;
    width: 103px;
}

.d .skill-tree-switcher div.switcher-confirm .confirm-links {
    padding-top: 14px;
    display: block;
}

.d .skill-tree-switcher .switcher-confirm .confirm-links a {
    color: #00a9f8;
    text-decoration: none;
}

.d .skill-tree-switcher .switcher-confirm .confirm-links a.yes {
    margin-right: 13px;
}

@media screen and (max-width: 784px) {

    .r .skill-tree-switcher {
        top: 559px;
        right: auto;
        left: 47px;
    }

    .r .skill-tree-switcher div.switcher-confirm {
        top: -38px;
        width: 101px;
    }

    .r .skill-tree-switcher div.switcher-confirm .confirm-links {
        padding-top: 18px;
    }

    .r .skill-tree-switcher .switcher-timer {
        position: relative;
        top: auto;
    }
}

@media screen and (max-width: 386px) {

    .r .skill-tree-switcher {
        left: 28px;
    }
}
