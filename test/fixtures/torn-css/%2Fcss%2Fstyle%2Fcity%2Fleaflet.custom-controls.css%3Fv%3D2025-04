.leaflet-bottom.leaflet-right{
    display: none;
}

.leaflet-right .leaflet-control {
  margin-right: 7px;
}

.full-map .leaflet-right .leaflet-control {
  margin-right: 36px;
}

.leaflet-top .leaflet-control {
  margin-top: 7px;
}

.full-map .leaflet-top .leaflet-control {
  margin-top: 22px;
}

@media screen and (max-width: 784px) {

	.r #map {
		width: 384px;
	}

	.r .leaflet-control-custom {
		background-image: url("/images/v2/city/citymap/controls_widget/touchscreen_widget_bg.png");
		background-repeat: no-repeat;
	    height: 238px;
	    width: 36px;
	    margin-top: 6px;
	}

	.r .leaflet-control-btn-full-screen {
		background-image: url("/images/v2/city/citymap/controls_widget/touchscreen_full screen_bg.png");
		background-position: 0 0;
		height: 38px;
	}

	.r .leaflet-control-custom-button.full-map {
	    left: 11px;
	    top: 11px;
	}

	.r .leaflet-control-custom .pan {
		display: none;
	}

	.r .leaflet-control-custom-button.link-control-btn {
		top: 58px;
	}

	.r .leaflet-control-custom-button.zoom {
		left: 12px;
	}
	.r .leaflet-control-custom-button.zoom.in {
		top: 88px;
	}
	.r .leaflet-control-custom-button.zoom.out {
		top: 120px;
	}

	.r .leaflet-control-custom-button.terr {
		left: 6px;
	}

	.r .leaflet-control-custom-button.terr.own-faction {
		top: 146px;
	}

	.r .leaflet-control-custom-button.terr.sector {
		top: 177px;
	}

	.r .leaflet-control-custom-button.terr.density {
		top: 208px;
	}

	.r .leaflet-control-custom-button.terr.size {
	    top: 242px;
	}

	.r .link-control-btn {
		left: 12px;
	}


}

@media screen and (max-width: 386px) {

	.r #map {
		width: 318px;
	}

}
